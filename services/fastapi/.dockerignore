# ── Python artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
.env/

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── IDE & editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Secrets (never bake into image) ──────────────────────────────────────────
.env
.env.*
!.env.example

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docs & local scripts ──────────────────────────────────────────────────────
docs/
*.md
*.rst

# ── Test files (not needed at runtime) ───────────────────────────────────────
tests/

# ── Ruff / linting cache ──────────────────────────────────────────────────────
.ruff_cache/

# ── Local SQLite test databases ───────────────────────────────────────────────
*.db
*.sqlite3
test.db

# ── Temporary uploads ────────────────────────────────────────────────────────
uploads/
tmp/
